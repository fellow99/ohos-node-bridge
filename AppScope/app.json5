{
  "app": {
    // 仅用于本仓库自测 / 样例 HAP；**库（HAR）本身不带 bundleName**，
    // 消费方（如 pi-desktop-ark）用自己的包名。
    // AppScope 级 bundleName 全工程唯一：probe-app 与 minimal-app 同属这个 App。
    //（specs/101-probe-app/plan.md §3.2 记录：tools/probe.mjs 的 BUNDLE=…sample 已不命中 probe-app）
    "bundleName": "org.fellow99.nodebridge.probe",
    "vendor": "fellow99",
    "versionCode": 100,
    "versionName": "0.1.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "minAPIVersion": 17,
    "targetAPIVersion": 24
  }
}
