# ── 构建产物 ──
/**/build/
/**/.hvigor/
/**/.cxx/
/**/.preview/
/.idea/
*.iml
oh_modules/
/**/oh_modules/

# ── 本机签名材料（DevEco 生成，**勿入库**）──
signing.*.local.json
*.p12
*.p7b
*.cer

# ── 运行时二进制 ──
# libnode.so（约 121 MB）由 tools/provision.mjs 投放进**消费方模块**，本仓库不入库（见 runtime.lock.json / 附录 G）
**/libnode.so
**/libc++_shared.so
# 若手工把运行时放进库模块做本地试验（hvigor 的 CMake 产物落点由工具链决定，不在 src/main/libs/，
# 这里两个路径都排掉，避免误提交 121 MB）
library/libs/
library/src/main/libs/
*.har

# ohpm 生成的本地依赖锁（本仓库不提交任何 lock；下次 ohpm install 会重写）
oh-package-lock.json5
/**/oh-package-lock.json5

# hvigor 生成的构建期常量（每次构建重写，不入库）
/**/BuildProfile.ets
