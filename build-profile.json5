{
  "app": {
    // 签名材料**不入库**：由 hvigorfile.ts 在构建时从 signing.<mode>.local.json（gitignored）
    // 或环境变量注入。没有材料时产出未签名包 —— 本仓库的编译验证不依赖密钥。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.5(17)",
        "compatibleSdkVersionStage": "release",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "nativeLib": {
            "collectAllLibs": true
          },
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "library",
      "srcPath": "./library",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      // 最小样例 + 内置探针（HAP）。它**消费**本库（oh-package.json5 里 file:../../library），
      // 用途：① 证明 HAR 能被消费、能装进 HAP；② 作为真机探针（/facts 取证，见 docs/000 §7.2）。
      "name": "minimalapp",
      "srcPath": "./samples/minimal-app",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      // PRB 探针应用（HAP，feature 模块，specs/101-probe-app）。只消费本库 + 判据化探针五项
      //（PRB-01 加载 / PRB-02 启动 / PRB-03 起服 / PRB-04 host桥 / PRB-05 版本契约）。
      // type: feature —— minimal-app 已占 entry（Stage 模型下产品最多一个 entry，见 specs/101-probe-app/plan.md §3.3）。
      "name": "probeapp",
      "srcPath": "./probe-app",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
