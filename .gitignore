# ── 构建产物 ──
/**/build/
/**/.hvigor/
/**/.cxx/
/**/.preview/
/.idea/
*.iml
oh_modules/
/**/oh_modules/

# ── 本机签名材料（DevEco 生成，**勿入库**）──
signing.*.local.json
*.p12
*.p7b
*.cer

# ── 运行时二进制 ──
# libnode.so 由独立仓库 ohos-node-runtime 发布到 ohpm（@fellow99/node-runtime），
# 本仓库不存储、不投放运行时二进制。
**/libnode.so
**/libc++_shared.so
library/libs/
library/src/main/libs/
*.har

# ohpm 生成的本地依赖锁（本仓库不提交任何 lock；下次 ohpm install 会重写）
oh-package-lock.json5
/**/oh-package-lock.json5

# hvigor 生成的构建期常量（每次构建重写，不入库）
/**/BuildProfile.ets
